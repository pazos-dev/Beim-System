{
  "name": "beim-system-tech",
  "version": "0.0.0",
  "private": true,
  "description": "Beim System Tech — Admin panel monorepo",
  "packageManager": "pnpm@11.3.0",
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "turbo run dev",
    "dev-not-login": "pnpm --filter @beim/gestion dev-not-login",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
