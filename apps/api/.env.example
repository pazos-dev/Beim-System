# Primary way to reach Postgres. When DATABASE_URL is set it wins; otherwise
# the app builds the connection string from PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
DATABASE_URL=postgres://beim@127.0.0.1:5432/beim_api

# HTTP port for the Express server.
PORT=4000

# development | test | production
NODE_ENV=development
# Webshop module (PR 4): uploads, checkout, session lifetimes.
# Directory where validated image uploads are stored (created if missing).
UPLOADS_DIR=uploads
# Upload size cap in bytes (server-side; > cap → 413).
MAX_UPLOAD_BYTES=5242880
# Base URL used to build checkout-session payment URLs.
CHECKOUT_BASE_URL=http://localhost:4000
# Web session lifetime in days (token hash + expiry; one active session per user).
SESSION_TTL_DAYS=30
# Checkout session lifetime in minutes (payment stays unpaid until webhook).
CHECKOUT_SESSION_TTL_MINUTES=60
